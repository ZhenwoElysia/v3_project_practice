{
  "name": "vue3_project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:test": "vue-tsc && vite build --mode test",
    "build:produstion": "vue-tsc && vite build --mode produstion",
    "preview": "vite preview",
    "lint": "eslint src",
    "fix": "eslint src --fix",
    "prepare": "husky",
    "format": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^24.3.0",
    "axios": "^1.11.0",
    "commitlint": "^19.8.1",
    "element-plus": "^2.11.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "sass": "^1.91.0",
    "sass-loader": "^16.0.5",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "fast-glob": "^3.3.3",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "mockjs": "^1.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.2",
    "vite-plugin-mock": "^2.9.6",
    "vue-tsc": "^3.0.5"
  }
}
