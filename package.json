    "fix": "eslint src --fix",
    "prepare": "husky",
    "format": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "commitlint": "^19.8.1",
    "element-plus": "^2.11.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  }
}
