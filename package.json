{
  "name": "vue3_project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "dev": "vite --open",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
